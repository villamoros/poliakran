# Configuración del backend para desarrollo local. Copia a .env y ajusta.
# Las variables del entorno del sistema tienen prioridad sobre este archivo.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# PostgreSQL local (docker compose up -d db)
DATABASE_URL=postgres://poliakran:poliakran@localhost:5432/poliakran?sslmode=disable
# Solo para `go test`: base de datos desechable para pruebas de integración
TEST_DATABASE_URL=postgres://poliakran:poliakran@localhost:5432/poliakran_test?sslmode=disable
MIGRATE_ON_START=true

# Sesiones
SESSION_TTL=168h
SESSION_COOKIE_NAME=pa_session
# En local se sirve por http; en producción debe ser true.
SESSION_COOKIE_SECURE=false

# Orígenes permitidos para operaciones que cambian estado (separados por comas)
ALLOWED_ORIGINS=http://localhost:3000
# true solo si el backend está detrás de un proxy propio (Next.js en local)
TRUST_PROXY=true

# Límite de intentos de registro/login por IP y ventana
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW=1m
